# Origen permitido para CORS (la URL donde corre tu app de Base44)
# Dejalo en * mientras desarrollas
CORS_ORIGIN=*

# Conseguilo gratis en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
TUNNEL_PORT=4040

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/database
APP_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# PostgreSQL Configuration
POSTGRES_DB=database
POSTGRES_USER=pulso_user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Adminer Configuration
ADMINER_PORT=8081